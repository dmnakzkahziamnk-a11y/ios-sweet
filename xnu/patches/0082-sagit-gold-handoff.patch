diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -99,6 +99,20 @@
  *	x21 - CPU data pointer
  */
 	.text
+#if defined(SWEET)
+/*
+ * Gold-cluster entry (sagit / msm8998).
+ *
+ * PSCI CPU_ON delivers the context id in x0, which is how the boot args
+ * pointer crosses the handoff: a core started through PSCI does NOT inherit
+ * the caller's registers. Resume at start_first_cpu, which re-derives
+ * everything else from MPIDR.
+ */
+	.align	7
+.Lgold_entry:
+	b		EXT(start_first_cpu)
+#endif /* defined(SWEET) */
+
 	.align 12
 	.globl EXT(LowResetVectorBase)
 LEXT(LowResetVectorBase)
@@ -459,6 +473,100 @@
 	// Unlock the core for debugging
 	msr		OSLAR_EL1, xzr
 	msr		DAIFSet, #(DAIFSC_ALL)				// Disable all interrupts
+
+#if defined(SWEET)
+/*
+ * sagit / msm8998: XNU needs the 16K translation granule.
+ *
+ * MSM8998 is two clusters of four: cpu0-3 Kryo 280 Silver (Cortex-A53 class)
+ * and cpu4-7 Kryo 280 Gold (Cortex-A73 class). The Silver cluster does not
+ * implement TGran16 (ID_AA64MMFR0_EL1.TGran16 == 1 means "not implemented"),
+ * so the MMU faults the instant it is enabled with TG1 = 16K there. ABL
+ * starts us on CPU0, a Silver core.
+ *
+ * Wake Gold CPU 0x100 through PSCI CPU_ON, passing the boot args pointer as
+ * the context id, then park this core. Nothing has been loaded yet and the
+ * MMU is still off, so this is a plain physical jump to .Lgold_entry.
+ */
+	mrs		x15, MPIDR_EL1
+	tst		x15, #0x100				// Gold cluster?
+	b.ne		.Lsagit_on_gold
+	mrs		x16, ID_AA64MMFR0_EL1
+	ubfx	x16, x16, #20, #4		// TGran16
+	cmp		x16, #1
+	b.ne		.Lsagit_have_16k		// Silver does implement 16K here
+
+	mov		x19, x0					// boot args, for the failure path
+	mov		x3, x0					// PSCI context id -> Gold's x0
+	MOV64	x0, 0xC4000003			// PSCI CPU_ON, 64-bit convention
+	mov		x1, #0x100				// target: Gold cluster, core 0
+	adr		x2, .Lgold_entry		// physical entry (MMU off, V != P)
+	smc		#0
+	cbnz	x0, .Lsagit_psci_failed	// non-zero: PSCI refused
+.Lsagit_park:
+	wfi
+	b		.Lsagit_park
+
+.Lsagit_psci_failed:
+	mov		x0, x19					// fall through on Silver and fail later
+
+.Lsagit_on_gold:
+	/*
+	 * Row 1600 magenta: this core is in the Gold cluster, so the PSCI
+	 * handoff worked. The white bar at row 1800 (patch 0010) is drawn
+	 * afterwards on this same path, so "magenta + white" means success
+	 * and "white only" means PSCI refused and we are still on Silver.
+	 */
+	MOV64	x1, (0x9d400000 + 1600 * 4320)
+	MOV64	x2, 0x00ff00ff
+	bl		.Lsagit_band
+
+	/*
+	 * Row 1650: which exception level did this core come up in? XNU
+	 * expects EL1. A core started by PSCI normally arrives at EL1
+	 * (that is where Linux runs on this SoC), but ABL may have left the
+	 * boot core at EL2, in which case the two differ.
+	 *
+	 *   green  = EL1 (what XNU wants)
+	 *   cyan   = EL2
+	 *   red    = EL3 or anything else
+	 */
+	mrs		x8, CurrentEL
+	ubfx	x8, x8, #2, #2
+	MOV64	x2, 0x0000ff00
+	cmp		x8, #1
+	b.eq	.Lsagit_el_band
+	MOV64	x2, 0x0000ffff
+	cmp		x8, #2
+	b.eq	.Lsagit_el_band
+	MOV64	x2, 0x00ff0000
+.Lsagit_el_band:
+	MOV64	x1, (0x9d400000 + 1650 * 4320)
+	bl		.Lsagit_band
+
+.Lsagit_have_16k:
+	b		.Lsagit_band_done
+
+/* x1 = row start, x2 = colour. Clobbers x3-x7. */
+.Lsagit_band:
+	mov		x3, #1080
+	mov		x4, #4320
+	mov		x5, #32
+.Lsagit_mark_row:
+	mov		x6, x1
+	mov		x7, x3
+.Lsagit_mark_pix:
+	str		w2, [x6], #4
+	subs	x7, x7, #1
+	b.ne	.Lsagit_mark_pix
+	add		x1, x1, x4
+	subs	x5, x5, #1
+	b.ne	.Lsagit_mark_row
+	dsb		sy
+	ret
+
+.Lsagit_band_done:
+#endif /* defined(SWEET) */
 
 	mov		x20, x0
 	mov		x21, #0
