diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -452,6 +452,73 @@
  * Cold boot init routine.  Called from __start
  *   x0 - Boot args
  */
+#if defined(SWEET)
+/*
+ * sagit bring-up instrumentation.
+ *  SWEET_BAR row, color - paint a 64x32 bar at that framebuffer row.
+ *  SWEET_HEX value, row - dump a 64-bit value as 16 horizontal bars, one per
+ *                         nibble, MSB first; bar y = row + nibble*20 and its
+ *                         grey level is nibble*16, so a screenshot decodes it.
+ * Clobbers x6-x14 only (scratch at every call site below).
+ */
+.macro SWEET_BAR row, color
+	MOV64	x6, (0x9d400000 + \row * 4320)
+	MOV64	x7, \color
+	mov	x8, #32
+	mov	x9, #4320
+.Lbar_row_\@:
+	mov	x10, #64
+	mov	x11, x6
+.Lbar_pix_\@:
+	str	w7, [x11], #4
+	subs	x10, x10, #1
+	b.ne	.Lbar_pix_\@
+	add	x6, x6, x9
+	subs	x8, x8, #1
+	b.ne	.Lbar_row_\@
+	dsb	sy
+.endm
+
+/* x12 = value to dump, \row = top bar row. 16 nibbles, 20 rows apart. */
+.macro SWEET_HEX row
+	mov	x14, #0
+.Lhex_nib_\@:
+	mov	x8, #15
+	sub	x8, x8, x14
+	lsl	x8, x8, #2
+	lsr	x13, x12, x8
+	and	x13, x13, #0xf
+	lsl	x13, x13, #4
+	orr	x13, x13, #0xff000000
+	orr	x13, x13, x13, lsl #8
+	orr	x13, x13, x13, lsl #16
+
+	mov	x9, #20
+	madd	x9, x14, x9, xzr
+	add	x9, x9, #\row
+	MOV64	x6, 0x9d400000
+	MOV64	x10, 4320
+	madd	x6, x9, x10, x6
+
+	mov	x8, #16
+.Lhex_row_\@:
+	mov	x10, #64
+	mov	x11, x6
+.Lhex_pix_\@:
+	str	w13, [x11], #4
+	subs	x10, x10, #1
+	b.ne	.Lhex_pix_\@
+	MOV64	x11, 4320
+	add	x6, x6, x11
+	subs	x8, x8, #1
+	b.ne	.Lhex_row_\@
+
+	add	x14, x14, #1
+	cmp	x14, #16
+	b.ne	.Lhex_nib_\@
+	dsb	sy
+.endm
+#endif
 	.align 2
 	.globl EXT(start_first_cpu)
 LEXT(start_first_cpu)
@@ -550,6 +617,7 @@
 	str		x0, [x1], #(1 << TTE_SHIFT)			//   Invalidate and advance
 	subs	x2, x2, #1							//   entries--
 	b.ne	Linvalidate_bootstrap				// } while (entries != 0)
+	SWEET_BAR 950, 0xff00ff00
 
 	/*
 	 * In order to reclaim memory on targets where TZ0 (or some other entity)
@@ -719,6 +787,14 @@
 	msr		MAIR_EL1, x0
 	isb
 	tlbi	vmalle1
+	mrs	x12, tcr_el1
+	SWEET_HEX 80
+	mrs	x12, ttbr1_el1
+	SWEET_HEX 430
+	mrs	x12, ttbr0_el1
+	SWEET_HEX 780
+	mrs	x12, mair_el1
+	SWEET_HEX 1130
 	dsb		ish
 
 
